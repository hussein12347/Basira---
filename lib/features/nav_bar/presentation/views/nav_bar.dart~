import 'package:flutter/material.dart';
import 'package:flutter_svg/svg.dart';
import 'package:go_router/go_router.dart'; // تأكد من استدعاء المكتبة

import '../../../../const/resource.dart';
import '../../../../core/utls/widgets/app_animations.dart';

// حولناها لـ StatelessWidget لأن go_router هو اللي هيحتفظ بالـ State
class NavBar extends StatelessWidget {
  const NavBar({super.key, required this.navigationShell});

  // بنستقبل الـ navigationShell من الـ AppRouter
  final StatefulNavigationShell navigationShell;

  @override
  Widget build(BuildContext context) {
    // قائمة الأيقونات الخاصة بك
    List icons = [
      R.assetsImagesSvgHeartSvg,
      R.assetsImagesSvgHomeSvg,
      R.assetsImagesSvgSettingSvg,
    ];

    // بنجيب الـ index الحالي من الـ go_router مباشرة
    final int currentIndex = navigationShell.currentIndex;

    return Scaffold(
      extendBody: true,
      // الـ body هنا هو الـ navigationShell اللي بيعرض الصفحات تلقائياً
      body: navigationShell,
      bottomNavigationBar: SafeArea(
        child: Padding(
          padding: const EdgeInsets.symmetric(horizontal: 32.0),
          child: Container(
            height: 60,
            padding: const EdgeInsets.all(12),
            margin: const EdgeInsets.only(left: 32, right: 32, bottom: 12),
            decoration: BoxDecoration(
              color: Theme.of(context).cardColor.withOpacity(.7),
              borderRadius: BorderRadius.circular(24),
              boxShadow: [
                BoxShadow(
                  color: Theme.of(context).brightness == Brightness.dark
                      ? Colors.black.withOpacity(0.3)
                      : Colors.black.withOpacity(0.05),
                  offset: const Offset(0, 4),
                  blurRadius: 4,
                  spreadRadius: 0,
                ),
                BoxShadow(
                  color: Theme.of(context).brightness == Brightness.dark
                      ? Colors.black.withOpacity(0.4)
                      : Colors.black.withOpacity(0.1),
                  offset: const Offset(0, 15),
                  blurRadius: 25,
                  spreadRadius: -5,
                ),
              ],
            ),
            child: Padding(
              padding: const EdgeInsets.symmetric(horizontal: 16.0),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                mainAxisSize: MainAxisSize.min,
                // استخدمنا icons.length بدل _pages.length
                children: List.generate(
                  icons.length,
                      (index) => Column(
                    crossAxisAlignment: CrossAxisAlignment.center,
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      AnimatedContainer(
                        duration: const Duration(milliseconds: 500),
                        height: 4,
                        margin: const EdgeInsets.only(bottom: 6),
                        width: currentIndex == index ? 20 : 0,
                        decoration: BoxDecoration(
                          borderRadius: BorderRadius.circular(2),
                          color: Theme.of(context).colorScheme.secondary,
                        ),
                      ),
                      GestureDetector(
                        onTap: () {
                          // هنا بنستخدم go_router عشان نتنقل بين الصفحات
                          navigationShell.goBranch(
                            index,
                            // لو ضغط على نفس التاب، بيرجعه لأول صفحة في الفرع ده
                            initialLocation: index == navigationShell.currentIndex,
                          );
                        },
                        // رتبت لك شرط الـ if عشان يكون أنظف وميقرأش الكود مرتين
                        child: (currentIndex == index)
                            ? _buildSvgIcon(context, icons[index], true)
                            .animateSlideTopToNormal(
                          duration: const Duration(milliseconds: 350),
                        )
                            : _buildSvgIcon(context, icons[index], false),
                      ),
                    ],
                  ),
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }

  // عملت ميثود صغيرة تبني الـ Svg عشان الكود ميكونش متكرر ومزحوم
  Widget _buildSvgIcon(BuildContext context, String iconPath, bool isActive) {
    return SvgPicture.asset(
      iconPath,
      height: 25,
      width: 30,
      // استخدمت colorFilter بدل color لأن color بقت Deprecated في الإصدارات الجديدة من flutter_svg
      colorFilter: ColorFilter.mode(
        isActive
            ? Theme.of(context).colorScheme.secondary
            : Theme.of(context).brightness == Brightness.dark
            ? Colors.white
            : Colors.black,
        BlendMode.srcIn,
      ),
    );
  }
}